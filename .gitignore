# ============================================
#  Laravel .gitignore
#  ريبو عام - استثناء كل الملفات الحساسة
# ============================================

# ===== Environment =====
#.env
.env.backup
.env.production
.env.local
.env.*.local

# ===== Dependencies =====
/node_modules
/vendor
/.pnp
.pnp.js

# ===== Build Artifacts =====
/public/build
/public/hot
/public/storage
/storage/*.key

# ===== Database =====
/database/database.sqlite
/database/*.sqlite
/database/*.sqlite-journal
*.sqlite

# ===== Cache & Logs =====
/bootstrap/cache/*
/storage/logs/*
/storage/framework/cache/*
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/app/*
/storage/app/public/*

# ===== IDE & Editor =====
.idea/
.vscode/
*.swp
*.swo
*~
.project
.settings/
*.sublime-workspace
*.sublime-project

# ===== OS Files =====
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ===== Logs =====
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.phpunit.result.cache
.phpunit.cache
.php-cs-fixer.cache

# ===== Coverage =====
/coverage
*.lcov
.clover

# ===== Backup Files =====
*.bak
*.backup
*.old

# ===== Composer / NPM =====
composer.phar
.phpactor.json
.phpunit.cache

# ===== Private Keys =====
*.pem
*.key
!public/*.key